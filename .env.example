# ── Database (required) ─────────────────────────────────────────────────────
# Dedicated role + database on the PostgreSQL server (see docs/ops/database.md)
NUXT_DATABASE_URL=postgres://trestero:trestero@localhost:5432/trestero

# ── Storage ─────────────────────────────────────────────────────────────────
# Where uploads (images, models, thumbnails) are stored. In Docker: /data (volume)
NUXT_DATA_DIR=./.data

# ── Catalogue ───────────────────────────────────────────────────────────────
# €/kg given to filaments auto-created when a 3MF uses an unknown filament
NUXT_DEFAULT_FILAMENT_PRICE_PER_KG=20
# Printer you own, as MakerWorld names it: imports preselect print profiles sliced for it
NUXT_PUBLIC_PRINTER_MODEL=A1 mini

# ── Translation (ADR 0008) ──────────────────────────────────────────────────
# URL of a self-hosted LibreTranslate server (no account, texts stay at home), e.g.
# http://3tero-traductor:5000 in the stack. Empty: imports show no "Traducir al español" button.
# Dev: docker run -p 5055:5000 -e LT_LOAD_ONLY=en,es,de libretranslate/libretranslate:v1.9.6
NUXT_TRANSLATE_URL=

# ── Limits (ADR 0004) ───────────────────────────────────────────────────────
NUXT_LIMITS_MAX_MODEL_MB=250
NUXT_LIMITS_WARN_MODEL_MB=50
NUXT_LIMITS_MAX_IMAGE_MB=15
NUXT_LIMITS_MAX_FILES_PER_PROJECT=20
NUXT_LIMITS_MAX_IMAGES_PER_PROJECT=30
NUXT_LIMITS_STORAGE_QUOTA_GB=20
